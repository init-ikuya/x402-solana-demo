GATEWAY_PAY_TO=YOUR_SOLANA_DEVNET_WALLET_ADDRESS
GATEWAY_FACILITATOR_URL=http://127.0.0.1:4022
GATEWAY_PORT=4021
FACILITATOR_KEYPAIR_FILE=/absolute/path/to/fee-payer-keypair.json
FACILITATOR_PORT=4022
FACILITATOR_RPC_URL=https://api.devnet.solana.com
# To enable upto, deploy this repository's Anchor program first. The merchant key must match GATEWAY_PAY_TO.
# UPTO_ENABLED=1
# UPTO_MERCHANT_KEYPAIR_FILE=/absolute/path/to/merchant-keypair.json
# UPTO_RPC_URL=https://api.devnet.solana.com
# Official SVM batch-settlement uses the Solana Foundation payment-channels program.
# Enable the same switch for the facilitator and gateway.
# BATCH_ENABLED=1
# BATCH_RECEIVER_KEYPAIR_FILE=/absolute/path/to/receiver-authorizer-keypair.json
# BATCH_RPC_URL=https://api.devnet.solana.com
# BATCH_REDEEM_INTERVAL_SECONDS=30
# BATCH_CHANNEL_STORE_FILE=.batch-gateway-channels.json
# BATCH_FACILITATOR_CHANNEL_STORE_FILE=.batch-facilitator-channels.json
# BATCH_PENDING_STORE_FILE=.batch-facilitator-pending.json
# Experimental escrow-only auth-capture binding in this repository's Anchor program.
# Deploy the current program first; the merchant key must match GATEWAY_PAY_TO.
# AUTH_CAPTURE_ENABLED=1
# AUTH_CAPTURE_MERCHANT_KEYPAIR_FILE=/absolute/path/to/merchant-keypair.json
# AUTH_CAPTURE_RPC_URL=https://api.devnet.solana.com
