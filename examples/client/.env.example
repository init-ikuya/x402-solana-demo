GATEWAY_PAY_TO=YOUR_SOLANA_DEVNET_WALLET_ADDRESS
PAYMENT_CLIENT_KEYPAIR_FILE=/absolute/path/to/your/devnet-keypair.json
PAYMENT_SCHEME=exact
# PAYMENT_DEMO_TRACE=1 shows decoded HTTP payment headers without signed payload bytes.
PAYMENT_MAX_AMOUNT=1000
# PAYMENT_RESOURCE_URL defaults to the selected scheme's local demo route.
# CLI defaults to one request and a 1000-unit total cap. The agent defaults to four calls and 4000 units.
# AGENT_REQUEST_COUNT=3
# AGENT_MAX_PAYMENTS=3
# AGENT_MAX_TOTAL_AMOUNT=3000
# The browser demo defaults to LM Studio. Start its local server and load a tool-capable model.
# Use the exact model identifier listed at GET http://127.0.0.1:1234/v1/models.
# AGENT_MODEL_PROVIDER=lm-studio
# LM_STUDIO_BASE_URL=http://127.0.0.1:1234
# LM_STUDIO_MODEL=YOUR_LOADED_MODEL_ID
# The standalone agent defaults to Ollama; set AGENT_MODEL_PROVIDER=ollama to use it in the browser demo.
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen3
# AGENT_SCHEMES=exact,upto
# To use this repository's Anchor upto route: PAYMENT_SCHEME=upto or AGENT_SCHEMES=upto
# UPTO_RESOURCE_URL=http://127.0.0.1:4021/api/trump-insider/upto
# Refund after an upto deposit expires: npm run refund:env --workspace @anchoring-payment-channels/client
# PAYMENT_RPC_URL=https://api.devnet.solana.com
# PAYMENT_ASSET=LOCAL_TEST_MINT_ADDRESS (local validator rehearsal only; match gateway)
# UPTO_CHANNEL_ID=CHANNEL_ADDRESS_IF_MULTIPLE_EXPIRED_CHANNELS_EXIST
# AGENT_PROMPT=Call both paid API tools, then compare their fictional results and costs.
# Project-specific Anchor batch-settlement: one reusable channel and periodic facilitator redemption.
# PAYMENT_SCHEME=batch-settlement
# AGENT_SCHEMES=batch-settlement
# BATCH_RESOURCE_URL=http://127.0.0.1:4021/api/trump-insider/batch
# BATCH_DEPOSIT_AMOUNT=3000
# With a 3000-unit CLI deposit, also set AGENT_MAX_TOTAL_AMOUNT=3000.
# BATCH_CLIENT_STORE_FILE=.local/anchor-batch-client.json
# Experimental auth-capture escrow route: hold 1000 units, capture 300, release 700.
# PAYMENT_SCHEME=auth-capture
# AGENT_SCHEMES=auth-capture
# AUTH_CAPTURE_RESOURCE_URL=http://127.0.0.1:4021/api/trump-insider/auth-capture
# Browser demo: npm run demo:env --workspace @anchoring-payment-channels/client
# DEMO_PORT=4023
# DEMO_AGENT_PROMPT=Call the auth-capture paid API once and state the charge in atomic token units.
# After payment, save the printed payment ID. Merchant-funded refund or payer reclaim:
# AUTH_CAPTURE_PAYMENT_ID=PAYMENT_PDA
# AUTH_CAPTURE_ACTION=refund_captured
# AUTH_CAPTURE_AMOUNT=100
# AUTH_CAPTURE_MERCHANT_KEYPAIR_FILE=/absolute/path/to/merchant-keypair.json
# For payer reclaim after the capture deadline, set AUTH_CAPTURE_ACTION=reclaim_hold.
